# Environment Configuration
PROJECT_NAME="Secure Enterprise RAG & Agentic Knowledge Platform"
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/enterprise_records.db
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
USE_SQLITE_FALLBACK=True
# Development may create tables; hardened production requires explicit migrations.
DATABASE_SCHEMA_MODE=create
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_INFLIGHT=16
HTTP_BODY_TIMEOUT_SECONDS=5
HTTP_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]","testserver"]

# Qdrant Vector DB
QDRANT_PREFER_LOCAL=True
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=eu_ai_act_bilingual

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=30.0

# Langfuse Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-local-dummy
LANGFUSE_SECRET_KEY=sk-lf-local-dummy
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=False

# Security Guardrails
ENABLE_PII_MASKING=True
ENABLE_PROMPT_GUARD=True
STRICT_TOOL_PERMISSIONS=True
SECRET_KEY=


# Privileged access has no built-in credentials. Provision a long random key locally.
# API_KEYS={"<random-key>":{"username":"operator","role":"compliance_officer","department":"legal_compliance"}}
API_KEYS={}
# Required only for checkpoint creation/verification; provision at least 32 random characters.
AUDIT_CHECKPOINT_KEY=
# Explicit browser origins, e.g. ["http://localhost:5173"]. Cookies are not used.
ALLOWED_ORIGINS=[]

# Stdio adapter credential; must match a provisioned key in API_KEYS.
MCP_API_KEY=

# Frozen baseline: curated. The hardened Docker overlay selects the official snapshot.
CORPUS_VARIANT=curated
# Optional model source selection; answer text remains extractive and checked.
SYNTHESIS_MODE=extractive
# Required by compose.hardened.yml; provision a random secret, never postgres/postgres.
KONTEXT_POSTGRES_PASSWORD=
# Additional approved HTTP hosts can be added explicitly.
MCP_ALLOWED_HOSTS=["127.0.0.1","localhost","::1","testserver"]
